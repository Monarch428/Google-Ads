# Database credentials for Render-hosted PostgreSQL
DB_USER=your_render_db_user
DB_PASSWORD=your_render_db_password
DB_HOST=your-render-db-host.render.com
DB_PORT=5432
DB_NAME=your_render_db_name

# Application secrets
SECRET_KEY=replace_with_secure_random_string

# Optional integrations
OPENAI_API_KEY=your_openai_api_key
